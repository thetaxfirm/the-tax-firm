# Build context excludes. Without this, `COPY . .` would overwrite the image's
# own `pnpm install` output with the host's node_modules — whose pnpm symlinks
# point at paths that do not exist inside the container.
node_modules
**/node_modules
.pnpm-store

# Build outputs — regenerated by `pnpm build` inside the image.
dist
build

# Local-only state.
.git
.env
.env.*
!.env.example
*.log
coverage
.vscode
.idea
.DS_Store

# Docs and CI have no bearing on the runtime image.
*.md
.github
